def logaritmo(): # 14
    try:
        log_num = float(input("Ingrese un numero: "))
        log_base = int(input("Ingrese un numero base: "))

        if log_base <= 0 or log_num <= 0:
            print("¡ERROR! El numero base y el numero deben ser mayores a cero.")
            return
    except ValueError:
        print("¡ERROR! INGRESA UN NUMERO VALIDO")
    
    log_calc = float(math.log(log_num, log_base))
    print("El logaritmo de >>>",log_num,"<<< en base >>>",log_base,"<<< es igual a >>>",log_calc)

def potencias(): # 15
    try:
        base = float(input("Ingrese un numero base: "))
        exponente = int(input("Ingrese un numero exponente: "))
        if base <= 0 or exponente <= 0:
            print("¡ERROR! El numero base y el numero exponente deben ser mayores a cero.")
            return
    except ValueError:
        print("¡ERROR! INGRESA UN NUMERO VALIDO")

    resultado = math.pow(base, exponente)
    print("La potencia de >>>",base,"<<< elevado a >>>",exponente,"<<< es igual a >>>", resultado)

def raiz_cuadrada(): # 16
    try:
        numero_raiz = int(input("Ingrese un numero: "))
        raiz_cuadrada = math.sqrt(numero_raiz)
        print("La raiz cuadrada de >>>",numero_raiz,"<<< es igual a >>>",raiz_cuadrada,"<<<")
    except ValueError:
        print("¡ERROR! INGRESA UN NUMERO VALIDO")

