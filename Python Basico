# Ejemplo de if else + while
def datos_Correctos(si):
    if si == "si":
        return "¡Buena! +2 puntos" # Si la condición se cumple, devolvera el texto marcado
    else: # Caso contrario
         return "¡Suerte a la proxima!-2 puntos" # Devolvera este texto.
    
def calificacion():
    while True:
            si = str(input("¿Los datos eran correctos? (si/no): "))
            if si == "si" or si == "no":
                return si
            else:
                 print("Por favor, responde con 'si' o 'no'")

si = calificacion()
resultado = datos_Correctos(si)
print(resultado)

